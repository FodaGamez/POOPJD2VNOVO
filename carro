public class Carro : Veiculo
{
    public Carro (string marca, string modelo) : base(string marca, string modelo) {}

    public int numportas { get; set;}

    public Carro(int Numportas)
    {
        Numportas = numportas;
    } 

    public override string Info()
    {
        Console.WriteLine($"Carro: {Marca}, {Modelo}, {Numportas}");
    }
}